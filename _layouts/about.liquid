---
layout: default
---
<style>
  .about-home .about-heading { display: flex; align-items: center; gap: 28px; margin-bottom: 28px; }
  .about-home .about-portrait { flex: 0 0 160px; }
  .about-home .about-portrait img { display: block; width: 160px; height: 190px; object-fit: cover; border-radius: 6px; }
  .about-home .about-identity { min-width: 0; }
  .about-home .about-body { font-size: 16px; line-height: 1.75; }
  .about-home .interest-note { margin: 24px 0 18px; padding: 20px 24px; border: 1px solid #dce3e8; border-radius: 8px; background: #f8fafb; color: #26333d; }
  .about-home .interest-note h2 { margin: 0 0 12px; font-size: 19px; font-weight: 600; line-height: 1.4; letter-spacing: 0; }
  .about-home .interest-note ul { margin: 0; padding-left: 20px; }
  .about-home .interest-note li { margin: 6px 0; padding-left: 4px; }
  .about-home .interest-note li::marker { color: #527489; }
  .about-home .interest-note strong { font-weight: 600; }
  .about-home .interest-note span { color: #53616c; }
  .about-home .phd-note { margin: 18px 0; padding: 18px 24px; border: 1px solid #bfdcd4; border-left: 4px solid #39826f; border-radius: 8px; background: #f0f8f5; color: #253d35; line-height: 1.7; }
  .about-home .phd-note p { margin: 0; }
  .about-home .phd-note strong { font-weight: 600; color: #216551; }
  .about-home .about-contact { margin-top: 18px; font-size: 15px; }
  html[data-theme="dark"] .about-home .interest-note { background: #242a2e; border-color: #414b52; color: #edf1f3; }
  html[data-theme="dark"] .about-home .interest-note span { color: #c0cad0; }
  html[data-theme="dark"] .about-home .phd-note { background: #23342f; border-color: #426c5e; color: #e0eee7; }
  html[data-theme="dark"] .about-home .phd-note strong { color: #a4dbc4; }
  @media (max-width: 575px) {
    .about-home .about-heading { gap: 18px; }
    .about-home .about-portrait { flex-basis: 100px; }
    .about-home .about-portrait img { width: 100px; height: 125px; }
    .about-home .post-title { font-size: 28px; }
    .about-home .post-title span { display: block; margin: 6px 0 0 !important; }
    .about-home .interest-note, .about-home .phd-note { padding: 16px 18px; }
    .about-home .interest-note span { display: block; }
  }
</style>
<div class="post about-home">
  <header class="post-header">
    <div class="about-heading">
      <!-- Profile Image -->
      <div class="about-portrait">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          <img src="{{ profile_image_path | relative_url }}" alt="Junyi Wu" width="160" height="190">
        {% endif %}
      </div>
      <!-- Name and Title -->
      <div class="about-identity">
        <h1 class="post-title">
          {{ site.first_name }} {{ site.last_name }}
          {% if site.cn_name %}
            <span style="font-size: 0.6em; color: #666; margin-left: 8px;">{{ site.cn_name }}</span>
          {% endif %}
        </h1>
        <div class="social-small">
          <div class="contact-icons">
            {% assign email_addr = site.data.socials.email | default: site.email %}
            {% if email_addr %}
            <a href="mailto:{{ email_addr }}" title="email"><i class="fa-solid fa-envelope"></i></a>
            <span class="divider" style="margin: 0 5px;"></span>
            {% endif %}
            {% if site.scholar_userid %}
            <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" title="Google Scholar"><i class="ai ai-google-scholar"></i></a>
            <span class="divider" style="margin: 0 5px;"></span>
            {% endif %}
            {% if site.github_username %}
            <a href="https://github.com/{{ site.github_username }}" title="GitHub"><i class="fab fa-github"></i></a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
    <div class="about-body">{{ content }}</div>
  </header>

  <article>

    <div style="margin-bottom: 50px;"></div>
    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}
    <div style="margin-bottom: 50px;"></div>

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}
    <div style="margin-bottom: 50px;"></div>

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
